<Window x:Class="HirRadar.RefreshHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HírRadar – Ellenőrzési előzmények" Width="1130" Height="725"
        MinWidth="920" MinHeight="580" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#081725" Foreground="#E3F0FA" FontFamily="Segoe UI" Icon="Assets/HirRadarIcon.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="HÍRFORRÁSOK ELLENŐRZÉSI ELŐZMÉNYEI" FontSize="20" FontWeight="Bold" Foreground="#55D9D5"/>
        <TextBlock Grid.Row="1" Text="Legfeljebb 200 ellenőrzési ciklus, maximum 14 napig. A legfrissebb ciklust válaszd ki a forrásonkénti részletekhez."
                   Foreground="#93B9CC" Margin="0,7,0,8" TextWrapping="Wrap" FontSize="12"/>
        <Border Grid.Row="2" Background="#123246" CornerRadius="5" Padding="11,8" Margin="0,0,0,11">
            <TextBlock x:Name="SummaryText" Foreground="#BCE8E7" FontSize="12"
                       Text="Az elmúlt 24 óra eredményeinek betöltése..."/>
        </Border>
        <DataGrid x:Name="HistoryGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" RowHeight="31"
                  SelectionChanged="HistoryGrid_SelectionChanged"
                  Background="#10283D" Foreground="#EAF8FF" RowBackground="#122B40"
                  AlternatingRowBackground="#17334A" BorderBrush="#2C5269"
                  HorizontalGridLinesBrush="#2C455B" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Befejezés" Binding="{Binding FinishedDisplay}" Width="168"/>
                <DataGridTextColumn Header="Ellenőrzött" Binding="{Binding CheckedSources}" Width="95"/>
                <DataGridTextColumn Header="Sikeres" Binding="{Binding SuccessfulSources}" Width="82"/>
                <DataGridTextColumn Header="Hibás" Binding="{Binding FailedSources}" Width="72"/>
                <DataGridTextColumn Header="Új hírek" Binding="{Binding NewArticles}" Width="80"/>
                <DataGridTextColumn Header="Időtartam" Binding="{Binding DurationDisplay}" Width="90"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" Margin="0,15,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="KIVÁLASZTOTT CIKLUS – FORRÁSONKÉNT" FontSize="13" FontWeight="SemiBold" Foreground="#55D9D5"/>
            <TextBlock Grid.Column="1" x:Name="DetailStatus" HorizontalAlignment="Right" TextWrapping="Wrap"
                       Foreground="#A6C8D8" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
        <DataGrid x:Name="SourceResultsGrid" Grid.Row="5" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" RowHeight="30"
                  Background="#10283D" Foreground="#EAF8FF" RowBackground="#122B40"
                  AlternatingRowBackground="#17334A" BorderBrush="#2C5269"
                  HorizontalGridLinesBrush="#2C455B" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Forrás" Binding="{Binding SourceName}" Width="170"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding StateDisplay}" Width="85"/>
                <DataGridTextColumn Header="Válaszidő" Binding="{Binding DurationDisplay}" Width="83"/>
                <DataGridTextColumn Header="Találat" Binding="{Binding ArticlesFound}" Width="70"/>
                <DataGridTextColumn Header="Új cím" Binding="{Binding NewArticles}" Width="65"/>
                <DataGridTextColumn Header="Lekérési módszer / hiba" Binding="{Binding DetailDisplay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6" Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HistoryStatus" VerticalAlignment="Center" FontSize="12" Foreground="#93B9CC"/>
            <Button Grid.Column="1" x:Name="ExportButton" Content="Részletes CSV export..." Click="ExportCsv_Click"
                    MinWidth="178" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Bezárás" Width="108" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
