<Window x:Class="HirRadar.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HírRadar v1.0.2 – Belföldi hírfigyelő" Width="1290" Height="820" MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#081725" Foreground="#E3F0FA" FontFamily="Segoe UI" Icon="Assets/HirRadarIcon.png"
        Closing="Window_Closing" StateChanged="Window_StateChanged" KeyDown="Window_KeyDown">
  <Grid x:Name="WindowContent">
    <Grid.RowDefinitions>
      <RowDefinition Height="84"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#10283D" BorderBrush="#24526A" BorderThickness="0,0,0,1" Padding="24,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- Külön, háttér nélküli, szorosan körbevágott fejléc-logó; nem a teljes splash kép. -->
        <Border Background="Transparent" VerticalAlignment="Center" Padding="0" Margin="0,0,18,0">
          <Image Source="Assets/HirRadarHeaderLogo.png" Height="56" Width="180" Stretch="Uniform"
                 HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="WatchButton" Content="Kulcsszavak / helyi hírek..." Click="WatchButton_Click"
                  Background="#155E65" Margin="0,0,10,0"/>
          <Button x:Name="SettingsButton" Content="Háttér / értesítések..." Click="SettingsButton_Click"
                  Background="#16435D" Margin="0,0,23,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CountText" Text="0 hír" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock x:Name="NextCheckText" Text="Következő ellenőrzés: —" Foreground="#A7C3D6" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#102337" Padding="21,10" BorderBrush="#1D3A50" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="170"/>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="118"/>
          <ColumnDefinition Width="136"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,10,0" ToolTip="Keresés a hírek címeiben" TextChanged="Filter_Changed"/>
        <ComboBox x:Name="DateMode" Grid.Column="1" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Mai hírek"/><ComboBoxItem Content="Elmúlt 24 óra"/><ComboBoxItem Content="Összes"/>
        </ComboBox>
        <ComboBox x:Name="SourceMode" Grid.Column="2" Margin="0,0,10,0" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
        <CheckBox x:Name="UnreadOnly" Grid.Column="3" Content="Olvasatlan" Margin="4,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        <CheckBox x:Name="StarredOnly" Grid.Column="4" Content="Csillagozott" Margin="2,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        <Button x:Name="CheckButton" Grid.Column="5" Content="Frissítés most" Background="#12666D" Margin="0,0,10,0" Click="CheckButton_Click"/>
        <Button x:Name="SourcesButton" Grid.Column="6" Content="Források..." Click="SourcesButton_Click"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FIGYELT HÍREK:" VerticalAlignment="Center" Foreground="#9ABDD0" Margin="0,0,10,0" FontSize="11"/>
          <ComboBox x:Name="FocusMode" Width="208" Margin="0,0,14,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
            <ComboBoxItem Content="Minden hír"/>
            <ComboBoxItem Content="Összes figyelt találat"/>
            <ComboBoxItem Content="Csak helyi találatok"/>
            <ComboBoxItem Content="Csak kulcsszavas találatok"/>
          </ComboBox>
          <TextBlock x:Name="WatchSummaryText" Text="Figyelések betöltése..." VerticalAlignment="Center" Foreground="#F4C86F" FontSize="12"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="7" Margin="0,9,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Text="VONATKOZÁS:" VerticalAlignment="Center" Foreground="#9ABDD0" Margin="0,0,8,0" FontSize="11"/>
          <ComboBox x:Name="DomesticMode" Width="230" SelectedIndex="1" Margin="0,0,15,0" SelectionChanged="Filter_Changed"
                    ToolTip="Címalapú, becsült belföldi relevancia. Nem töröl cikket; a bizonytalan hírek külön is megtekinthetők.">
            <ComboBoxItem Content="Minden hír"/>
            <ComboBoxItem Content="Belföld + bizonytalan"/>
            <ComboBoxItem Content="Csak magyar vonatkozású"/>
            <ComboBoxItem Content="Valószínű külföldi"/>
            <ComboBoxItem Content="Nem besorolható"/>
          </ComboBox>
          <TextBlock Text="TÉMA:" VerticalAlignment="Center" Foreground="#9ABDD0" Margin="0,0,8,0" FontSize="11"/>
          <ComboBox x:Name="TopicMode" Width="200" DisplayMemberPath="Name" Margin="0,0,17,0" SelectionChanged="Filter_Changed"/>
          <TextBlock Text="MENTETT NÉZET:" VerticalAlignment="Center" Foreground="#9ABDD0" Margin="0,0,8,0" FontSize="11"/>
          <ComboBox x:Name="ProfileMode" Width="205" DisplayMemberPath="Name" Margin="0,0,9,0" SelectionChanged="ProfileMode_SelectionChanged"/>
          <Button Content="Témák szerkesztése..." Click="Topics_Click" Background="#155E65" Margin="0,0,8,0" Padding="10,7"/>
          <Button Content="Nézet mentése" Background="#155E65" Click="SaveView_Click" Margin="0,0,8,0" Padding="10,7"/>
          <Button x:Name="DeleteViewButton" Content="Törlés" Click="DeleteView_Click" Margin="0,0,8,0" Padding="10,7" IsEnabled="False"/>
          <Button Content="Alapszűrők" Click="ResetFilters_Click" Margin="0,0,12,0" Padding="10,7"/>
          <CheckBox x:Name="GroupCompactCheck" Content="Kapcsolódók összevonása" Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
          <Button Content="Exportálás..." Click="Export_Click" Background="#14596A" Padding="10,7"/>
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="18,14,18,12">
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="17,0,17,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
        <TextBlock Text="IDŐPONT" Foreground="#7295AA" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="FORRÁS" Foreground="#7295AA" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="HÍR CÍME · KATTINTÁS AZ OLVASÓNÉZETHEZ" Foreground="#7295AA" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="MENTÉS" Foreground="#7295AA" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
      <ListView x:Name="NewsList" Grid.Row="1" Background="#091C2B" Foreground="#E4F0F9" BorderBrush="#203B51" BorderThickness="1"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" SelectionMode="Single">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#19435A"/></Trigger></Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#18354A" BorderThickness="0,0,0,1" Padding="16,12">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PublishedDisplay}" Foreground="#93C4D4" FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock Text="{Binding DayDisplay}" Foreground="#64899F" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SourceName}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#4DD0D1" FontSize="12" Margin="0,0,9,0"/>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#1A7D76" CornerRadius="3" Padding="5,2" Margin="0,0,7,0" VerticalAlignment="Center"
                          Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ÚJ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                  </Border>
                  <Border Grid.Column="1" Background="#805B2D" CornerRadius="3" Padding="5,2" Margin="0,0,7,0" VerticalAlignment="Center"
                          ToolTip="{Binding MatchedTerms}" Visibility="{Binding IsLocalMatch, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="HELYI" Foreground="#FFF2CC" FontSize="10" FontWeight="SemiBold"/>
                  </Border>
                  <Border Grid.Column="2" Background="#265A87" CornerRadius="3" Padding="5,2" Margin="0,0,7,0" VerticalAlignment="Center"
                          ToolTip="{Binding MatchedTerms}" Visibility="{Binding IsKeywordMatch, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="FIGYELT" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                  </Border>
                  <Border Grid.Column="3" Background="#942E3A" BorderBrush="#E47575" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,7,0" VerticalAlignment="Center"
                          ToolTip="{Binding AffiliationDetails}" Visibility="{Binding HasAffiliation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding AffiliationDisplay}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                  </Border>
                  <Button Grid.Column="4" Click="ToggleArticle_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Foreground="#E3F2FA" ToolTip="Cikk olvasása itt, a lista alatt">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ExpandSymbol}" FontSize="17" Foreground="#60D6D7" Margin="0,0,8,0" VerticalAlignment="Top"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#E3F2FA"/>
                              <Style.Triggers><DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Foreground" Value="#85A4B8"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TopicLabels, StringFormat='TÉMA: {0}'}" Foreground="#759AB1" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <Button Grid.Column="3" Tag="{Binding}" Click="Star_Click" Background="Transparent" BorderThickness="0" Padding="4" FontSize="22"
                        Foreground="#F7C766" Content="{Binding StarSymbol}" ToolTip="Hír megjelölése / jelölés megszüntetése" HorizontalAlignment="Center"/>
                <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="96,13,68,6" Padding="17,17,17,14"
                        Background="#102C42" BorderBrush="#286074" BorderThickness="1" CornerRadius="7"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <Grid Margin="0,0,0,11">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="CIKK OLVASÁSA · HÍRRADAR" FontSize="11" FontWeight="SemiBold" Foreground="#55D9D5" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Cikk másolása" Tag="{Binding}" Click="CopyArticle_Click"
                              IsEnabled="{Binding CanCopyArticle}" ToolTip="A cikk címe és teljes felismert törzsszövege formázás nélkül a vágólapra"
                              Background="#155E65" Margin="0,0,8,0" Padding="11,7"/>
                      <Button Grid.Column="2" Content="Eredeti cikk ↗" Tag="{Binding}" Click="OpenOriginal_Click" Margin="0,0,8,0" Padding="11,7"/>
                      <Button Grid.Column="3" Content="Bezárás ▲" Tag="{Binding}" Click="CloseArticle_Click" Padding="11,7"/>
                    </Grid>
                    <TextBlock Text="{Binding ArticleStatus}" TextWrapping="Wrap" Foreground="#8CBBCB" FontSize="12" Margin="0,0,0,9"/>
                    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ArticleScroll_PreviewMouseWheel" Padding="0,0,10,0" CanContentScroll="False">
                      <ItemsControl ItemsSource="{Binding ArticleBlocks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,0,0,13">
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="25">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Foreground" Value="#EAF4FA"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                        <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#55D9D5"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsQuote}" Value="True"><Setter Property="FontStyle" Value="Italic"/><Setter Property="Foreground" Value="#B3D8E3"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRelated, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding RelatedDisplay}" Foreground="#55D9D5" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                      <ItemsControl ItemsSource="{Binding RelatedItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,3">
                              <TextBlock Text="{Binding SourceName}" Foreground="#85B9D0" Width="130" VerticalAlignment="Center"/>
                              <Button Content="{Binding Title}" Tag="{Binding}" Click="ToggleArticle_Click"
                                      HorizontalContentAlignment="Left" MaxWidth="670" Padding="7,5" Background="#173D52"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Border Grid.Row="3" Background="#10283D" BorderBrush="#24526A" BorderThickness="0,1,0,0" Padding="22,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Előkészítés..." VerticalAlignment="Center" FontSize="11" Foreground="#A8CADB" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="CacheButton" Grid.Column="1" Content="Cache: számítás..." Click="CacheButton_Click"
                Background="Transparent" BorderThickness="0" Padding="8,4" FontSize="11" ToolTip="Korábbi verzióból maradt képcache ellenőrzése és törlése"/>
        <TextBlock Grid.Column="2" Text="HírRadar v1.0.2 · F5 / Ctrl+F" VerticalAlignment="Center" FontSize="11" Foreground="#638CA1"/>
      </Grid>
    </Border>
  </Grid>
</Window>
