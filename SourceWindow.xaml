<Window x:Class="HirRadar.SourceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HírRadar – Hírforrások és diagnosztika" Width="1390" Height="680" MinWidth="1100" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#091C2B" Foreground="#E3F0FA" FontFamily="Segoe UI" Icon="Assets/HirRadarIcon.png">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="FIGYELT HÍRFORRÁSOK" FontSize="19" FontWeight="SemiBold" Foreground="#51D7D3"/>
      <TextBlock Text="RSS/Atom-hírfolyam vagy híroldal címe · ötpercenkénti ellenőrzés · státusz forrásonként"
                 Margin="0,5,0,0" Foreground="#90B1C4" FontSize="12"/>
    </StackPanel>
    <DataGrid x:Name="SourcesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Single" SelectionChanged="SourcesGrid_SelectionChanged"
              Background="#10283D" Foreground="#EAF8FF" BorderBrush="#2C5269" RowBackground="#122B40" AlternatingRowBackground="#17334A"
              HeadersVisibility="Column" HorizontalGridLinesBrush="#2C455B" VerticalGridLinesBrush="#2C455B"
              ColumnHeaderHeight="36" RowHeight="39" GridLinesVisibility="Horizontal" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Aktív" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
        <DataGridTextColumn Header="Forrás" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
        <DataGridTextColumn Header="Forrás címe (URL)" Binding="{Binding FeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="200"/>
        <DataGridTemplateColumn Header="Kapcsolat" Width="104" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="#942E3A" CornerRadius="3" Padding="4,2" Margin="4,3" HorizontalAlignment="Left"
                      ToolTip="{Binding AffiliationDetails}" Visibility="{Binding HasAffiliation, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding AffiliationDisplay}" Foreground="White" FontSize="10" FontWeight="Bold"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Állapot" Width="112" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StateDisplay}" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#ACC7D8"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StateDisplay}" Value="Rendben"><Setter Property="Foreground" Value="#51D7D3"/></DataTrigger>
                      <DataTrigger Binding="{Binding StateDisplay}" Value="Hiba"><Setter Property="Foreground" Value="#FF9A9A"/></DataTrigger>
                      <DataTrigger Binding="{Binding StateDisplay}" Value="Üres"><Setter Property="Foreground" Value="#F4C86F"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Feldolgozás" Binding="{Binding MethodDisplay}" Width="115" IsReadOnly="True"/>
        <DataGridTextColumn Header="Utolsó ellenőrzés" Binding="{Binding LastCheckedDisplay}" Width="156" IsReadOnly="True"/>
        <DataGridTextColumn Header="Találat · idő" Binding="{Binding ResultDisplay}" Width="136" IsReadOnly="True"/>
        <DataGridTextColumn Header="Minőség / frissesség" Binding="{Binding QualityDisplay}" Width="165" IsReadOnly="True"/>
        <DataGridTextColumn Header="Hibák sorozatban" Binding="{Binding FailureStreakDisplay}" Width="110" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Margin="0,11,0,15" Padding="11,10" Background="#10283D" BorderBrush="#2C5269" BorderThickness="1" CornerRadius="5">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Hibaüzenet másolása" Click="CopyDiagnostics_Click"
                  Padding="10,4" FontSize="11" HorizontalAlignment="Right" Margin="12,0,0,0"/>
          <TextBlock Text="KIJELÖLT FORRÁS ELLENŐRZÉSE" Foreground="#51D7D3" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ErrorDetails" Foreground="#AFCADA" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Text="Válassz egy forrást a részletekhez."/>
        <TextBlock Text="A frissesség csak az elmúlt 24 órában publikált, ismert dátumú cikkeket számolja. A regionális források aktívak; a találatokhoz ellenőrizd a forrásonkénti állapotot. A szűrés alapból a mai híreket mutatja."
                   Foreground="#7293A8" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="+ Új forrás" Click="Add_Click" Margin="0,0,9,0"/>
      <Button Grid.Column="1" Content="Eltávolítás" Click="Remove_Click" Background="#542F3E"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0,0,0">
        <Button Content="Ellenőrzési előzmények..." Margin="0,0,9,0" Click="OpenHistory_Click" Background="#155E65"/>
        <Button Content="Naplómappa" Margin="0,0,9,0" Click="OpenLogs_Click"/>
        <Button Content="Diagnosztikai jelentés..." Background="#155E65" Click="ExportDiagnostics_Click"
                ToolTip="A források aktuális ellenőrzési adatait egyszerű szövegfájlba menti; a hírek tartalmát nem."/>
      </StackPanel>
      <Button Grid.Column="3" Content="Mégse" Click="Cancel_Click" Margin="0,0,9,0"/>
      <Button Grid.Column="4" Content="Mentés és ellenőrzés" Click="Save_Click" Background="#12666D"/>
    </Grid>
  </Grid>
</Window>
