<Window x:Class="HirRadar.CacheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HírRadar – Gyorsítótár" Width="575" Height="348" MinWidth="530" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#081725" Foreground="#E3F0FA" FontFamily="Segoe UI" Icon="Assets/HirRadarIcon.png">
  <Grid Margin="25,19,25,21">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="GYORSÍTÓTÁR KEZELÉSE" FontWeight="Bold" FontSize="22" Foreground="#54D9D5"/>
    <Border Grid.Row="1" Background="#122C41" BorderBrush="#2C5269" BorderThickness="1" CornerRadius="7" Margin="0,16,0,12" Padding="14,12">
      <StackPanel>
        <TextBlock x:Name="TotalSizeText" Text="Teljes cache: számítás..." FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="ImageSizeText" Text="Korábbi képek: számítás..." FontSize="13" Margin="0,5,0,0" Foreground="#A7C8D9"/>
        <TextBlock Text="Az új verzió nem tölt le és nem tárol cikkképeket. Itt kizárólag a korábbi kiadásokból megmaradt cache törölhető; a hírek és beállítások megmaradnak."
                   Margin="0,10,0,0" Foreground="#90B1C4" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="A régi cikkképek törlésével lemezterületet szabadíthatsz fel. A program ezeket többé nem tölti le, és a cikkolvasóban nem lesznek képes területek."
               Foreground="#B0CADB" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"/>
    <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="ImagesButton" Content="Régi képcache törlése" Click="ClearImages_Click" Background="#784E35" Margin="0,0,9,0"/>
      <Button x:Name="AllButton" Content="Teljes cache törlése" Click="ClearAll_Click" Background="#74404A" Margin="0,0,9,0"/>
      <Button Content="Bezárás" IsCancel="True" Width="90"/>
    </WrapPanel>
  </Grid>
</Window>
